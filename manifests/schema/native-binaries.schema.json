{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jax-source-analysis.local/schema/native-binaries.schema.json",
  "title": "Loaded native binary inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "inventory_id", "packages"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "inventory_id": {"$ref": "#/$defs/id"},
    "packages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/package"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "buildId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\\\]+$"},
    "packagePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\\\:]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runtimeRole": {"enum": ["python-extension", "cpu-backend", "gpu-backend", "tpu-simulator", "tpu-compiler", "tpu-runtime", "collective-runtime", "other"]},
    "opaqueArtifactUri": {"type": "string", "format": "uri", "pattern": "^artifact:[a-z0-9][a-z0-9._-]*$"},
    "identityBase": {
      "type": "object",
      "required": ["kind", "artifact_sha256", "artifact_size_bytes"],
      "properties": {
        "kind": {"enum": ["lock-artifact", "build-manifest", "repository-artifact", "opaque-artifact"]},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "lockIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "lock_path", "artifact_uri", "artifact_sha256", "artifact_size_bytes", "retrieval"],
      "properties": {
        "kind": {"const": "lock-artifact"},
        "lock_path": {"$ref": "#/$defs/relativePath"},
        "artifact_uri": {"$ref": "#/$defs/opaqueArtifactUri"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_size_bytes": {"type": "integer", "minimum": 0},
        "retrieval": {"type": "string", "minLength": 1}
      }
    },
    "buildIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "build_manifest", "build_manifest_sha256", "build_manifest_size_bytes", "build_id", "artifact_sha256", "artifact_size_bytes"],
      "properties": {
        "kind": {"const": "build-manifest"},
        "build_manifest": {"$ref": "#/$defs/relativePath"},
        "build_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "build_manifest_size_bytes": {"type": "integer", "minimum": 0},
        "build_id": {"$ref": "#/$defs/buildId"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "repositoryIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "artifact_path", "artifact_sha256", "artifact_size_bytes"],
      "properties": {
        "kind": {"const": "repository-artifact"},
        "artifact_path": {"$ref": "#/$defs/relativePath"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "opaqueIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "artifact_uri", "artifact_sha256", "artifact_size_bytes", "retrieval"],
      "properties": {
        "kind": {"const": "opaque-artifact"},
        "artifact_uri": {"$ref": "#/$defs/opaqueArtifactUri"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_size_bytes": {"type": "integer", "minimum": 0},
        "retrieval": {"type": "string", "minLength": 1}
      }
    },
    "identity": {"oneOf": [{"$ref": "#/$defs/lockIdentity"}, {"$ref": "#/$defs/buildIdentity"}, {"$ref": "#/$defs/repositoryIdentity"}, {"$ref": "#/$defs/opaqueIdentity"}]},
    "binary": {
      "type": "object", "additionalProperties": false,
      "required": ["package_path", "sha256", "size_bytes"],
      "properties": {
        "package_path": {"$ref": "#/$defs/packagePath"},
        "artifact_path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "source_component", "build_revision", "runtime_roles", "identity", "selection", "binaries"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "minLength": 1},
        "source_component": {"$ref": "#/$defs/id"},
        "build_revision": {"$ref": "#/$defs/gitCommit"},
        "runtime_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/runtimeRole"}},
        "identity": {"$ref": "#/$defs/identity"},
        "selection": {"type": "string", "minLength": 1},
        "binaries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binary"}}
      }
    }
  }
}
