{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jax-source-analysis.local/schema/project-status.schema.json",
  "title": "JAX source-analysis long-running project status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "updated_at",
    "objective",
    "plan_path",
    "baseline_path",
    "coverage_path",
    "current_phase",
    "milestones",
    "active_work",
    "next_actions",
    "external_inputs"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "updated_at": {"type": "string", "format": "date-time"},
    "objective": {"type": "string", "minLength": 1},
    "plan_path": {"$ref": "#/$defs/repositoryPath"},
    "baseline_path": {"$ref": "#/$defs/repositoryPath"},
    "coverage_path": {"$ref": "#/$defs/repositoryPath"},
    "current_phase": {"$ref": "#/$defs/phase"},
    "milestones": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/workItem"},
          {
            "properties": {"state": {"const": "complete"}},
            "required": ["state", "completed_at"]
          }
        ]
      }
    },
    "active_work": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/workItem"},
          {
            "properties": {
              "state": {
                "enum": ["planned", "running", "waiting-input", "blocked"]
              }
            },
            "required": ["state"],
            "not": {"required": ["completed_at"]}
          }
        ]
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nextAction"}
    },
    "external_inputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/externalInput"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\\\]+$"
    },
    "state": {
      "enum": ["planned", "running", "complete", "waiting-input", "blocked"]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "state"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P(?:[0-9]|1[0-5])(?:/P(?:[0-9]|1[0-5]))?$"
        },
        "title": {"type": "string", "minLength": 1},
        "state": {"$ref": "#/$defs/state"},
        "notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "state", "artifacts", "notes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "state": {"$ref": "#/$defs/state"},
        "completed_at": {"type": "string", "format": "date-time"},
        "artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryPath"}
        },
        "notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "next_command": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "complete"}},
            "required": ["state"]
          },
          "then": {"required": ["completed_at"]},
          "else": {"not": {"required": ["completed_at"]}}
        }
      ]
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "title", "depends_on"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "externalInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "required_for", "notes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "state": {"enum": ["available", "missing", "not-required-yet"]},
        "required_for": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
