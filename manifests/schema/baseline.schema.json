{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jax-source-analysis.local/schema/baseline.schema.json",
  "title": "Pinned analysis and runtime baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "external_inputs", "repository", "runtime", "status", "toolchain"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "external_inputs": {
      "type": "object", "additionalProperties": false, "required": ["libtpu", "tokamax", "tpu_target"],
      "properties": {
        "libtpu": {"type": ["object", "null"]},
        "tokamax": {"type": ["object", "null"]},
        "tpu_target": {"type": ["object", "null"]}
      }
    },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["inputs", "root", "sources"],
      "properties": {
        "inputs": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/file"}},
        "root": {"$ref": "#/$defs/root"},
        "sources": {
          "type": "object", "additionalProperties": false, "required": ["jax", "llvm", "shardy", "stablehlo", "xla"],
          "properties": {
            "jax": {"$ref": "#/$defs/source"},
            "llvm": {"$ref": "#/$defs/source"},
            "shardy": {"$ref": "#/$defs/source"},
            "stablehlo": {"$ref": "#/$defs/source"},
            "xla": {"$ref": "#/$defs/source"}
          }
        }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["device", "jax", "jaxlib"],
      "properties": {
        "device": {"$ref": "#/$defs/device"},
        "jax": {"$ref": "#/$defs/jaxRuntime"},
        "jaxlib": {"$ref": "#/$defs/jaxlibRuntime"}
      }
    },
    "status": {"$ref": "#/$defs/status"},
    "toolchain": {"$ref": "#/$defs/toolchain"}
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\\\]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "opaqueArtifactUri": {"type": "string", "format": "uri", "pattern": "^artifact:[a-z0-9][a-z0-9._-]*$"},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "size_bytes"],
      "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 0}}
    },
    "root": {
      "type": "object", "additionalProperties": false, "required": ["git_commit", "path", "verification"],
      "properties": {"git_commit": {"$ref": "#/$defs/gitCommit"}, "path": {"const": "."}, "verification": {"const": "ancestor"}}
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["path", "git_commit", "dirty", "status"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "git_commit": {"$ref": "#/$defs/gitCommit"},
        "dirty": {"type": "boolean"},
        "status": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {"if": {"properties": {"dirty": {"const": false}}, "required": ["dirty"]}, "then": {"properties": {"status": {"maxItems": 0}}}},
        {"if": {"properties": {"dirty": {"const": true}}, "required": ["dirty"]}, "then": {"properties": {"status": {"minItems": 1}}}}
      ]
    },
    "device": {
      "type": "object", "additionalProperties": false, "required": ["default_platform", "platforms", "device_count", "devices", "host_os", "arch"],
      "properties": {
        "default_platform": {"type": "string", "minLength": 1},
        "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "device_count": {"type": "integer", "minimum": 1},
        "devices": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "host_os": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "minLength": 1}
      }
    },
    "jaxRuntime": {
      "type": "object", "additionalProperties": false, "required": ["version", "install_type", "imported_file", "imported_file_sha256", "source_checkout_git_hash", "reported_git_hash"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "install_type": {"enum": ["editable-source", "environment"]},
        "imported_file": {"oneOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
        "imported_file_sha256": {"$ref": "#/$defs/sha256"},
        "source_checkout_git_hash": {"$ref": "#/$defs/gitCommit"},
        "reported_git_hash": {"oneOf": [{"$ref": "#/$defs/gitCommit"}, {"type": "null"}]}
      }
    },
    "lockIdentity": {
      "type": "object", "additionalProperties": false, "required": ["kind", "artifact_uri", "artifact_sha256", "artifact_size_bytes", "lock_path", "retrieval"],
      "properties": {
        "kind": {"const": "lock-artifact"},
        "artifact_uri": {"$ref": "#/$defs/opaqueArtifactUri"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_size_bytes": {"type": "integer", "minimum": 0},
        "lock_path": {"$ref": "#/$defs/relativePath"},
        "retrieval": {"type": "string", "minLength": 1}
      }
    },
    "buildIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "build_manifest", "build_manifest_sha256", "build_manifest_size_bytes", "build_id", "artifact_sha256", "artifact_size_bytes"],
      "properties": {
        "kind": {"const": "build-manifest"},
        "build_manifest": {"$ref": "#/$defs/relativePath"},
        "build_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "build_manifest_size_bytes": {"type": "integer", "minimum": 0},
        "build_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "repositoryIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "artifact_path", "artifact_sha256", "artifact_size_bytes"],
      "properties": {
        "kind": {"const": "repository-artifact"},
        "artifact_path": {"$ref": "#/$defs/relativePath"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "opaqueIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "artifact_uri", "artifact_sha256", "artifact_size_bytes", "retrieval"],
      "properties": {
        "kind": {"const": "opaque-artifact"},
        "artifact_uri": {"$ref": "#/$defs/opaqueArtifactUri"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_size_bytes": {"type": "integer", "minimum": 0},
        "retrieval": {"type": "string", "minLength": 1}
      }
    },
    "distributionIdentity": {"oneOf": [{"$ref": "#/$defs/lockIdentity"}, {"$ref": "#/$defs/buildIdentity"}, {"$ref": "#/$defs/repositoryIdentity"}, {"$ref": "#/$defs/opaqueIdentity"}]},
    "nativeBinary": {
      "type": "object", "additionalProperties": false, "required": ["package_path", "sha256", "size_bytes"],
      "properties": {
        "package_path": {"$ref": "#/$defs/relativePath"},
        "artifact_path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "jaxlibRuntime": {
      "type": "object", "additionalProperties": false, "required": ["version", "install_type", "package_root", "build_revision", "distribution", "native_binaries"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "install_type": {"enum": ["source-tree", "installed-wheel"]},
        "package_root": {"oneOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
        "build_revision": {"oneOf": [{"$ref": "#/$defs/gitCommit"}, {"type": "null"}]},
        "distribution": {"$ref": "#/$defs/distributionIdentity"},
        "native_binaries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nativeBinary"}}
      }
    },
    "status": {
      "type": "object", "additionalProperties": false, "required": ["evidence_level", "qualifiers", "jax_source_matches_jaxlib_build", "reason", "runtime_source_alignment"],
      "properties": {
        "evidence_level": {"const": "RUN-CPU"},
        "qualifiers": {"type": "array", "uniqueItems": true, "items": {"const": "VERSION-SKEW"}},
        "jax_source_matches_jaxlib_build": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "runtime_source_alignment": {"enum": ["ALIGNED", "VERSION-SKEW"]}
      }
    },
    "versionTriple": {
      "type": "object", "additionalProperties": false, "required": ["project_constraint", "repository_pin", "runtime"],
      "properties": {
        "project_constraint": {"type": "string", "minLength": 1},
        "repository_pin": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1}
      }
    },
    "uvTool": {
      "type": "object", "additionalProperties": false,
      "required": ["project_constraint", "repository_pin", "runtime", "artifact_uri", "artifact_sha256", "artifact_size_bytes", "retrieval"],
      "properties": {
        "project_constraint": {"type": "string", "minLength": 1},
        "repository_pin": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "artifact_uri": {"$ref": "#/$defs/opaqueArtifactUri"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_size_bytes": {"type": "integer", "minimum": 1},
        "retrieval": {"type": "string", "minLength": 1}
      }
    },
    "toolchain": {
      "type": "object", "additionalProperties": false, "required": ["python", "uv"],
      "properties": {"python": {"$ref": "#/$defs/versionTriple"}, "uv": {"$ref": "#/$defs/uvTool"}}
    }
  }
}
